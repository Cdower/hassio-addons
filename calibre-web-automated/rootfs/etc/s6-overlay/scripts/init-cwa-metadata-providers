#!/command/with-contenv bashio
# ==============================================================================
# Install custom metadata providers from `metadata_providers_path` into CWA's
# cps/metadata_provider/ directory. Runs after init-cwa-paths (so an SMB-hosted
# folder is already mounted) and before upstream's cwa-init, which every CWA
# service waits on, so nothing imports the providers before they are in place.
#
# Built-in providers are never overwritten: a custom file that shares a name
# with one is skipped (see install_providers.py). Optional feature — failures
# are logged but never block startup.
# ==============================================================================

INSTALLER=/opt/cwa-metadata-providers/install_providers.py
# Set by init-cwa-paths from `metadata_providers_path`; empty when unset.
PROVIDERS_PATH=${CWA_METADATA_PROVIDERS_PATH:-}

# Without --source the installer only removes what a previous run installed,
# which is what "disabled" means.
SOURCE=()
if [[ "${PROVIDERS_PATH}" == /* ]] && mkdir -p "${PROVIDERS_PATH}"; then
    SOURCE=(--source "${PROVIDERS_PATH}")
elif [ -n "${PROVIDERS_PATH}" ]; then
    bashio::log.warning \
        "metadata_providers_path must be an absolute path to a folder that can be created (got: ${PROVIDERS_PATH}); custom metadata providers disabled"
fi

if ! /lsiopy/bin/python3 "${INSTALLER}" "${SOURCE[@]}" && [ ${#SOURCE[@]} -gt 0 ]; then
    bashio::log.warning "Installing custom metadata providers failed (see above); continuing startup"
fi

exit 0
