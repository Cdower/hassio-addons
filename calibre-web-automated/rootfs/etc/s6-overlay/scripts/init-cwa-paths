#!/command/with-contenv bashio
# ==============================================================================
# Translate HA add-on options into the paths and env vars CWA expects.
# Runs as a oneshot before upstream's cwa-init service.
# ==============================================================================
set -e

# Print an option's value, or nothing when it is unset. `bashio::config`
# prints the literal string "null" for an option missing from options.json
# (which is what clearing an optional field in the UI does), and
# `bashio::var.has_value` counts "null" as a value.
config_value() {
    local value
    value=$(bashio::config "$1")
    if [ "${value}" != "null" ]; then
        printf '%s' "${value}"
    fi
}

# True when path $2 is base $1 or lies under it.
path_under() {
    [ "$2" = "$1" ] || [[ "$2" == "$1"/* ]]
}

LIBRARY_PATH=$(config_value 'library_path')
BOOKS_PATH=$(config_value 'books_path')
INGEST_PATH=$(config_value 'ingest_path')
CONFIG_PATH=$(config_value 'config_path')
PLUGINS_PATH=$(config_value 'plugins_path')
PROVIDERS_PATH=$(config_value 'metadata_providers_path')
SMB_SHARE=$(config_value 'smb_share')

# The path options, as option:VARIABLE pairs, for the checks that apply to
# all of them.
PATH_OPTIONS=(
    library_path:LIBRARY_PATH
    books_path:BOOKS_PATH
    ingest_path:INGEST_PATH
    plugins_path:PLUGINS_PATH
    metadata_providers_path:PROVIDERS_PATH
)

# Where `smb_share` is mounted inside the container. Path options point under
# it to use the share.
SMB_MOUNT_POINT=/mnt/smb

# True when path $1 is on the mounted smb_share.
on_smb_share() {
    bashio::var.has_value "${SMB_SHARE}" && path_under "${SMB_MOUNT_POINT}" "$1"
}

# Match the LSIO base's PUID/PGID (set in the Dockerfile) so directories we
# mkdir as root are usable by `abc` after it's remapped.
APP_UID=${PUID:-1000}
APP_GID=${PGID:-1000}

# Re-own only files we created (still root-owned) and tolerate filesystems
# that reject chown (SMB/NFS shares often do): warn and continue rather than
# aborting startup under `set -e`. `--from=0:0` is GNU coreutils, present in
# the LSIO Ubuntu base.
chown_if_root() {
    chown --from=0:0 "$@" 2>/dev/null \
        || bashio::log.warning "chown failed on $* (likely a network share that disallows it; skipping)"
}

bashio::log.info "Configuring CWA paths..."

# Bind-mount the user's chosen path over a target that the upstream image
# expects to find. We use bind mounts (not symlinks) because the targets are
# either Docker VOLUMEs (/config) or pre-populated directories that `ln -sfn`
# refuses to overwrite (e.g. /config/.config/calibre/plugins after the image
# seeds it). Idempotent: inspects /proc/self/mountinfo via findmnt to confirm
# whether target is already bind-mounted from source before mounting.
# Requires privileged: [SYS_ADMIN] in config.yaml and a matching mount rule
# in apparmor.txt for each target.
bind_user_path() {
    local source=$1 target=$2
    local real_source
    mkdir -p "${source}" "${target}"
    chown_if_root "${APP_UID}:${APP_GID}" "${source}"
    real_source=$(realpath "${source}")
    # Verify target is already bind-mounted from source by inspecting the mount
    # table. stat -c %d only compares device IDs and falsely matches any two
    # directories on the same filesystem, so it cannot confirm the correct source.
    if ! findmnt --noheadings --mountpoint "${target}" \
            --source "${real_source}" > /dev/null 2>&1; then
        mount --bind "${source}" "${target}"
    fi
}

# Mount `smb_share` at SMB_MOUNT_POINT, owned by APP_UID:APP_GID. Home
# Assistant's own Network Storage mounts CIFS shares as uid/gid 0 with mode
# 0755 and offers no way to change that, so `abc` cannot write to them; mounting
# the share here lets us choose the owner. The password goes through a
# credentials file rather than the mount options, so it never appears in
# /proc/mounts or a process listing. Requires privileged: [SYS_ADMIN,
# DAC_READ_SEARCH] in config.yaml (mount.cifs refuses to start without the
# latter) and the cifs mount rule in apparmor.txt.
mount_smb_share() {
    local opts cred="" err="" attempt version username domain

    if findmnt --noheadings --mountpoint "${SMB_MOUNT_POINT}" > /dev/null 2>&1; then
        return 0
    fi
    mkdir -p "${SMB_MOUNT_POINT}"

    # forceuid/forcegid: ignore any owner the server reports (Unix
    # extensions), so every file is APP_UID:APP_GID.
    opts="uid=${APP_UID},gid=${APP_GID},forceuid,forcegid,file_mode=0664,dir_mode=0775,iocharset=utf8"
    version=$(config_value 'smb_version')
    if [ -n "${version}" ]; then
        opts+=",vers=${version}"
    fi
    username=$(config_value 'smb_username')
    if [ -n "${username}" ]; then
        # mktemp creates the file 0600.
        cred=$(mktemp /run/cwa-smb-credentials.XXXXXX)
        domain=$(config_value 'smb_domain')
        {
            printf 'username=%s\n' "${username}"
            printf 'password=%s\n' "$(config_value 'smb_password')"
            if [ -n "${domain}" ]; then
                printf 'domain=%s\n' "${domain}"
            fi
        } > "${cred}"
        opts+=",credentials=${cred}"
    else
        opts+=",guest"
    fi

    # The NAS can still be waking up when Home Assistant boots, so retry for
    # about 20 seconds before giving up.
    for attempt in 1 2 3 4 5; do
        if err=$(mount -t cifs "${SMB_SHARE}" "${SMB_MOUNT_POINT}" -o "${opts}" 2>&1); then
            rm -f "${cred}"
            bashio::log.info "Mounted ${SMB_SHARE} at ${SMB_MOUNT_POINT} (owner ${APP_UID}:${APP_GID})"
            return 0
        fi
        bashio::log.warning "Mounting ${SMB_SHARE} failed (attempt ${attempt}/5): ${err}"
        if [ "${attempt}" -lt 5 ]; then
            sleep $((attempt * 2))
        fi
    done
    rm -f "${cred}"
    # Fatal: carrying on would point CWA at empty local directories under
    # SMB_MOUNT_POINT and it would start a brand-new, empty library there.
    bashio::exit.nok "Could not mount ${SMB_SHARE}: ${err}"
}

# Copy CWA's state from where /config used to live (the deprecated
# config_path) into /data once, so an install that kept /config on a share
# moves to local storage with its users and settings intact. Runs before /data
# is seeded or bind-mounted.
#
# Fails startup if the copy fails: carrying on would let cwa-init create a
# fresh app.db in /data, and that app.db would then block any later import.
import_legacy_config() {
    local source=$1 staging=/data/.cwa-config-import entry name

    if bashio::fs.file_exists "${IMPORT_MARKER}"; then
        bashio::log.info "CWA's config was already imported from $(cat "${IMPORT_MARKER}"); nothing to import"
        return 0
    fi
    if bashio::fs.file_exists /data/app.db; then
        bashio::log.warning "Local storage already has an app.db; not importing from ${source}. CWA uses the local copy; the one in ${source} is ignored."
        return 0
    fi
    if ! bashio::fs.file_exists "${source}/app.db"; then
        bashio::log.info "${source} has no app.db; nothing to import"
        return 0
    fi

    bashio::log.info "Importing CWA config from ${source} into local storage (one-time)"
    rm -rf "${staging}"
    mkdir -p "${staging}"
    if ! cp -R --preserve=timestamps "${source}/." "${staging}/"; then
        rm -rf "${staging}"
        bashio::exit.nok "Importing CWA config from ${source} failed (see above). Fix access to it, or clear config_path to start with an empty config."
    fi
    # Move the copy into place one top-level entry at a time. Anything /data
    # already has (options.json, Tailscale state, the add-on's own markers) is
    # kept as is.
    for entry in "${staging}"/* "${staging}"/.[!.]* "${staging}"/..?*; do
        [ -e "${entry}" ] || continue
        name=$(basename "${entry}")
        if [ -e "/data/${name}" ]; then
            bashio::log.warning "Not importing ${name}: /data already has one"
            continue
        fi
        mv "${entry}" "/data/${name}"
        chown_if_root -R "${APP_UID}:${APP_GID}" "/data/${name}"
    done
    rm -rf "${staging}"
    printf '%s\n' "${source}" > "${IMPORT_MARKER}"
    # The import is the seed; skip seeding /data from the image defaults.
    touch /data/.cwa-initialized
    bashio::log.info "Imported CWA config from ${source}. The copy left there is no longer used."
}

IMPORT_MARKER=/data/.cwa-config-imported
# Where earlier versions shipped their default folders, outside the add-on's
# backups.
LEGACY_ROOT=/share/calibre
# The shipped config_path before /config moved to local storage. An install
# that never saved its options has no config_path stored at all, so look here
# too, or that install would come up with an empty config.
LEGACY_DEFAULT_CONFIG=${LEGACY_ROOT}/config

# The add-on's addon_configs folder (`map: addon_config` in config.yaml). Like
# /data it is part of the add-on's own backups, and unlike /data it is
# reachable over Samba, so the shipped library, ingest and plugins folders
# live here.
ADDON_CONFIG=/addon_config

# Earlier versions shipped those defaults under LEGACY_ROOT, with the same
# folder names. An install that never saved its options picks up the new
# defaults on upgrade; if its data is still in the old default folder, keep
# using that instead of starting an empty one.
for pair in LIBRARY_PATH:calibre-library INGEST_PATH:cwa-book-ingest PLUGINS_PATH:plugins; do
    var=${pair%%:*}
    new_default=${ADDON_CONFIG}/${pair#*:}
    old_default=${LEGACY_ROOT}/${pair#*:}
    if [ "${!var}" = "${new_default}" ] && [ ! -e "${new_default}" ] \
            && [ -e "${old_default}" ]; then
        bashio::log.warning "Using ${old_default} instead of the new default ${new_default}, because your existing data is there. It is not in this add-on's backups; move it to ${new_default} to include it."
        printf -v "${var}" '%s' "${old_default}"
    fi
done

# Validate user-supplied paths up front. library_path and ingest_path are
# required by the schema; config_path and plugins_path are optional. All
# must be absolute since they are used as mkdir / bind-mount sources, and
# config_path must not collide with /config itself.
if ! bashio::var.has_value "${LIBRARY_PATH}"; then
    bashio::exit.nok "library_path must not be empty"
elif [[ "${LIBRARY_PATH}" != /* ]]; then
    bashio::exit.nok "library_path must be an absolute path (got: ${LIBRARY_PATH})"
fi
if ! bashio::var.has_value "${INGEST_PATH}"; then
    bashio::exit.nok "ingest_path must not be empty"
elif [[ "${INGEST_PATH}" != /* ]]; then
    bashio::exit.nok "ingest_path must be an absolute path (got: ${INGEST_PATH})"
fi
if bashio::var.has_value "${CONFIG_PATH}"; then
    if [[ "${CONFIG_PATH}" != /* ]]; then
        bashio::exit.nok "config_path must be an absolute path (got: ${CONFIG_PATH})"
    fi
    # Must not be /config or anything under /config/ to avoid seeding /config
    # onto itself and then removing it.
    if path_under /config "${CONFIG_PATH}"; then
        bashio::exit.nok "config_path must not be /config or a path under /config/ (got: ${CONFIG_PATH})"
    fi
fi
# books_path splits the library: metadata.db stays in library_path, the book
# folders live in books_path. Neither may contain the other, or the book
# folders and the database would end up mixed in one folder again.
if bashio::var.has_value "${BOOKS_PATH}"; then
    if [[ "${BOOKS_PATH}" != /* ]]; then
        bashio::exit.nok "books_path must be an absolute path (got: ${BOOKS_PATH})"
    fi
    real_library=$(realpath -m "${LIBRARY_PATH}")
    real_books=$(realpath -m "${BOOKS_PATH}")
    if path_under "${real_library}" "${real_books}" \
            || path_under "${real_books}" "${real_library}"; then
        bashio::exit.nok "books_path (${BOOKS_PATH}) and library_path (${LIBRARY_PATH}) must be separate folders, neither inside the other. Point library_path at local storage, e.g. ${ADDON_CONFIG}/calibre-library."
    fi
    # The ingest watcher consumes (and deletes) whatever lands in ingest_path,
    # so it must never see the library's book files.
    real_ingest=$(realpath -m "${INGEST_PATH}")
    if path_under "${real_ingest}" "${real_books}" \
            || path_under "${real_books}" "${real_ingest}"; then
        bashio::exit.nok "books_path (${BOOKS_PATH}) and ingest_path (${INGEST_PATH}) must be separate folders, neither inside the other."
    fi
fi
if bashio::var.has_value "${SMB_SHARE}"; then
    if [[ ! "${SMB_SHARE}" =~ ^//[^/]+/[^/]+ ]]; then
        bashio::exit.nok "smb_share must look like //server/share (got: ${SMB_SHARE})"
    fi
else
    # Without a share, SMB_MOUNT_POINT is a plain directory in the container's
    # writable layer, which is thrown away whenever the add-on is recreated.
    for pair in "${PATH_OPTIONS[@]}" config_path:CONFIG_PATH; do
        var=${pair#*:}
        if path_under "${SMB_MOUNT_POINT}" "${!var}"; then
            bashio::exit.nok "${pair%%:*} (${!var}) is under ${SMB_MOUNT_POINT}, but smb_share is not set"
        fi
    done
fi

if bashio::var.has_value "${SMB_SHARE}"; then
    mount_smb_share
fi

# Home Assistant backs up only /data and /addon_config with this add-on.
# Paths on the SMB share are the NAS's to back up; anything else (e.g. under
# /share or /media) is covered only by full backups that include that folder.
for pair in "${PATH_OPTIONS[@]}"; do
    var=${pair#*:}
    path=${!var}
    if [ -n "${path}" ] && ! path_under /data "${path}" \
            && ! path_under "${ADDON_CONFIG}" "${path}" \
            && ! path_under "${SMB_MOUNT_POINT}" "${path}"; then
        bashio::log.warning "${pair%%:*} (${path}) is not in this add-on's backups; only full Home Assistant backups that include its folder cover it. Use a path under ${ADDON_CONFIG} to include it."
    fi
done

# Starting from a restored backup: put the consistent database copies taken
# by `backup_pre` in place of the possibly torn live files (see
# db_snapshot.py). Must run before anything opens the databases.
if ! /lsiopy/bin/python3 /opt/cwa-backup/db_snapshot.py restore; then
    bashio::exit.nok "Restoring databases from backup snapshots failed (see above)"
fi
mkdir -p "${ADDON_CONFIG}"
chown_if_root "${APP_UID}:${APP_GID}" "${ADDON_CONFIG}"

# With books_path set, bring over the library's metadata.db the first time
# that books_path is used, or from the previous library_path when only that
# changed (see split_library.py `prepare`). This must run before cwa-init:
# cwa-auto-library would otherwise find no metadata.db in library_path and
# start a new, empty library there -- which metadata_db_export would then copy
# over the real database's copy in books_path. The state file records the
# library_path and books_path set up last; init-cwa-split-library uses it to
# switch split library mode back off once books_path is cleared.
SPLIT_STATE=/data/.cwa-split-library
if bashio::var.has_value "${BOOKS_PATH}"; then
    # Owners are set by bind_user_path below; prepare runs as root.
    mkdir -p "${LIBRARY_PATH}" "${BOOKS_PATH}"
    if ! /lsiopy/bin/python3 /opt/cwa-split-library/split_library.py prepare \
            --library "${LIBRARY_PATH}" --books "${BOOKS_PATH}" \
            --state "${SPLIT_STATE}"; then
        bashio::exit.nok "Setting up books_path failed (see above)"
    fi
    if ! path_under /data "${LIBRARY_PATH}" \
            && ! path_under "${ADDON_CONFIG}" "${LIBRARY_PATH}"; then
        bashio::log.warning "books_path is set, but library_path (${LIBRARY_PATH}) is not on the add-on's local storage. It holds metadata.db, so keep it under ${ADDON_CONFIG} to get SQLite's full speed and safety."
    fi
fi

# /config always lives on the add-on's local /data: SQLite's locking is not
# reliable on network shares, and /data survives add-on upgrades and is part
# of Home Assistant backups. config_path used to put /config on a share; it is
# now only a one-time import source.
CWA_CONFIG_TARGET="/data"
if bashio::var.has_value "${CONFIG_PATH}"; then
    bashio::log.warning "config_path is deprecated: /config now always lives on the add-on's local storage. Clear config_path in the add-on options."
    if [ "$(realpath -m "${CONFIG_PATH}")" != "${CWA_CONFIG_TARGET}" ]; then
        import_legacy_config "${CONFIG_PATH}"
    fi
elif ! bashio::fs.file_exists "${CWA_CONFIG_TARGET}/app.db" \
        && bashio::fs.file_exists "${LEGACY_DEFAULT_CONFIG}/app.db"; then
    import_legacy_config "${LEGACY_DEFAULT_CONFIG}"
fi

# Seed the persistent target from the current contents of /config on first
# use. This must run before the bind mount below: at this point /config is
# the upstream image's default contents. The sentinel lives next to the data.
if ! bashio::fs.file_exists "${CWA_CONFIG_TARGET}/.cwa-initialized"; then
    bashio::log.info "First use of ${CWA_CONFIG_TARGET} — seeding from current /config contents"
    if [ -d /config ] && [ -n "$(ls -A /config 2>/dev/null || true)" ]; then
        cp -an /config/. "${CWA_CONFIG_TARGET}/"
    fi
    touch "${CWA_CONFIG_TARGET}/.cwa-initialized"
    # Seed contents were copied as root; remap to APP_UID:APP_GID so `abc` can
    # read/write its own state. `--from=0:0` skips files the user owns
    # (relevant when migrating an existing install: doc tells users to delete
    # the sentinel after copying their old /config in).
    chown_if_root -R "${APP_UID}:${APP_GID}" "${CWA_CONFIG_TARGET}"
fi
bind_user_path "${CWA_CONFIG_TARGET}" /config

# Surface options as env vars for downstream s6-rc longruns. The /run/s6/container_environment
# directory is read by `with-contenv` for every service started after this oneshot.
mkdir -p /run/s6/container_environment
# On the SMB share, SQLite WAL corrupts and inotify misses files added from
# other machines. network_share_mode handles both, so turn it on when a
# database folder is on the share; /config always lives in /data, so that is
# only ever the library. With books_path, metadata.db stays in library_path and
# only book files sit on the share, which needs neither. If only the ingest
# folder is there, just switch the watchers to polling and keep WAL for the
# local databases.
NETWORK_SHARE_MODE=$(bashio::config 'network_share_mode')
if [ "${NETWORK_SHARE_MODE}" != "true" ]; then
    if on_smb_share "${LIBRARY_PATH}"; then
        bashio::log.info "library_path is on smb_share; enabling network_share_mode"
        NETWORK_SHARE_MODE=true
    elif on_smb_share "${INGEST_PATH}"; then
        bashio::log.info "ingest_path is on smb_share; watching it by polling"
        echo -n "poll" > /run/s6/container_environment/CWA_WATCH_MODE
    fi
fi

# Upstream cwa-init runs `chown -R abc:abc /config` on every boot, except
# under NETWORK_SHARE_MODE, where it skips it entirely. That leaves state
# written under a different uid unwritable for `abc` -- most commonly an
# app.db from the v4.0.6-based add-on, which ran as 911 before the image
# pinned PUID=1000, copied into /data by hand (the config import above
# re-owns what it copies) -- and CWA then dies on its first migration with
# "attempt to write a readonly database". Re-own only what doesn't already
# belong to APP_UID, so a correctly-owned /config costs one traversal and no
# writes. options.json (rewritten as root by the Supervisor on every start,
# and holding smb_password and tailscale_authkey) and tailscaled's state
# (root's tailnet node key) are not CWA's and stay root-only. Runs before
# plugins_path is bind-mounted under /config, and -xdev keeps it off any other
# filesystem. Failures warn instead of aborting startup.
if [ "${NETWORK_SHARE_MODE}" = "true" ]; then
    if ! reown_err=$(find /config -xdev \
            \( -path /config/options.json -o -path /config/tailscaled \) -prune \
            -o \( ! -uid "${APP_UID}" -o ! -gid "${APP_GID}" \) \
            -exec chown -h "${APP_UID}:${APP_GID}" {} + 2>&1 >/dev/null); then
        bashio::log.warning \
            "Could not re-own everything under ${CWA_CONFIG_TARGET} to ${APP_UID}:${APP_GID}: $(head -n 3 <<< "${reown_err}")"
    fi
    # Name the real cause up front rather than leave it to a SQLAlchemy
    # traceback. Tested as APP_UID, not by owner, so mode bits count too.
    if [ -e /config/app.db ] \
            && ! /command/s6-applyuidgid -u "${APP_UID}" -g "${APP_GID}" -G "" \
                test -w /config/app.db; then
        bashio::log.error \
            "${CWA_CONFIG_TARGET}/app.db (owner uid $(stat -c %u /config/app.db)) is not writable by uid ${APP_UID}; CWA will fail to start."
    fi
fi

bind_user_path "${LIBRARY_PATH}" /calibre-library
bind_user_path "${INGEST_PATH}" /cwa-book-ingest
if bashio::var.has_value "${BOOKS_PATH}"; then
    bind_user_path "${BOOKS_PATH}" /calibre-books
fi

mkdir -p /config/.config/calibre
chown_if_root "${APP_UID}:${APP_GID}" /config/.config /config/.config/calibre
if bashio::var.has_value "${PLUGINS_PATH}"; then
    bind_user_path "${PLUGINS_PATH}" /config/.config/calibre/plugins
    # No customize.py.json to hand-write any more: the image sets
    # CWA_CALIBRE_USER_PLUGINS=1 (see Dockerfile), so the cwa-auto-library
    # oneshot -- which runs after cwa-init, and therefore after this script has
    # bind-mounted plugins_path into place -- registers every .zip found here
    # via `calibre-customize -a` and writes the registry itself.
    #
    # plugins_path ships with a value, so report what is actually there rather
    # than announcing "plugins enabled" on every boot of an empty folder.
    shopt -s nullglob
    plugin_zips=(/config/.config/calibre/plugins/*.zip)
    shopt -u nullglob
    if [ ${#plugin_zips[@]} -gt 0 ]; then
        bashio::log.info \
            "Calibre plugins: registering ${#plugin_zips[@]} .zip file(s) from ${PLUGINS_PATH}"
    else
        bashio::log.info "Calibre plugins: none found in ${PLUGINS_PATH}"
    fi
fi

echo -n "${NETWORK_SHARE_MODE}" > /run/s6/container_environment/NETWORK_SHARE_MODE
# Read by init-cwa-split-library and cwa-metadata-export.
if bashio::var.has_value "${BOOKS_PATH}"; then
    echo -n "true" > /run/s6/container_environment/CWA_SPLIT_LIBRARY
else
    echo -n "false" > /run/s6/container_environment/CWA_SPLIT_LIBRARY
fi
# Read by init-cwa-metadata-providers.
echo -n "${PROVIDERS_PATH}" > /run/s6/container_environment/CWA_METADATA_PROVIDERS_PATH
echo -n "$(config_value 'hardcover_token')"    > /run/s6/container_environment/HARDCOVER_TOKEN
echo -n "$(bashio::config 'trusted_proxy_count')" > /run/s6/container_environment/TRUSTED_PROXY_COUNT
# Cloudflare Access mode: enabled only when BOTH options are set. When on,
# CWA moves to loopback :8084 and nginx takes over :8083 (LAN, headers
# stripped) and :8085 (docker-network-only, JWT-gated — the cloudflared
# add-on's target). When off, nothing changes: CWA serves 0.0.0.0:8083.
CF_TEAM_DOMAIN=$(config_value 'cloudflare_team_domain')
CF_TEAM_DOMAIN="${CF_TEAM_DOMAIN%.cloudflareaccess.com}"  # accept either form
CF_ACCESS_AUD=$(config_value 'cloudflare_access_aud')
CWA_ACCESS_ENABLED=false
if bashio::var.has_value "${CF_TEAM_DOMAIN}" && bashio::var.has_value "${CF_ACCESS_AUD}"; then
    CWA_ACCESS_ENABLED=true
    echo -n "true"               > /run/s6/container_environment/CWA_ACCESS_ENABLED
    echo -n "8084"               > /run/s6/container_environment/CWA_PORT_OVERRIDE
    echo -n "127.0.0.1"          > /run/s6/container_environment/CWA_BIND_ADDRESS
    echo -n "${CF_TEAM_DOMAIN}"  > /run/s6/container_environment/CF_TEAM_DOMAIN
    echo -n "${CF_ACCESS_AUD}"   > /run/s6/container_environment/CF_ACCESS_AUD
    bashio::log.info "Cloudflare Access mode enabled (team: ${CF_TEAM_DOMAIN})"
    bashio::log.info "Point the cloudflared add-on at: http://$(hostname):8085"
    bashio::log.info "LAN password login stays on port 8083 as before"
elif bashio::var.has_value "${CF_TEAM_DOMAIN}" || bashio::var.has_value "${CF_ACCESS_AUD}"; then
    bashio::log.warning \
        "cloudflare_team_domain and cloudflare_access_aud must BOTH be set — Cloudflare Access mode stays disabled"
    echo -n "false" > /run/s6/container_environment/CWA_ACCESS_ENABLED
else
    echo -n "false" > /run/s6/container_environment/CWA_ACCESS_ENABLED
fi
if bashio::config.has_value 'access_users' && [ "${CWA_ACCESS_ENABLED}" != "true" ]; then
    bashio::log.warning \
        "access_users is set but Cloudflare Access mode is disabled — no users will be created (they could not sign in)"
fi

# TZ is passed in by Supervisor (ENV_TIME in supervisor/docker/const.py), so
# read it from the env instead of hitting /supervisor/info — that endpoint
# needs hassio_api: true and otherwise logs a "missing API permission" error
# on every start.
TZ_VALUE="${TZ:-UTC}"
bashio::log.info "Setting TZ environment variable to ${TZ_VALUE}"
echo -n "${TZ_VALUE}" > /run/s6/container_environment/TZ

if bashio::var.has_value "${BOOKS_PATH}"; then
    bashio::log.info "CWA paths ready: library=${LIBRARY_PATH} (metadata.db), books=${BOOKS_PATH}, ingest=${INGEST_PATH}"
else
    bashio::log.info "CWA paths ready: library=${LIBRARY_PATH}, ingest=${INGEST_PATH}"
fi
