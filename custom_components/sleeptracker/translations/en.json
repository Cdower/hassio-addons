  "services": {
    "send_command": {
      "name": "Send bed command",
      "description": "Send a raw bedControlCommand code to the bed frame and return the cloud's response. For commands this integration has no entity for.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "The Sleeptracker account whose bed receives the command."
        },
        "processor_id": {
          "name": "Processor ID",
          "description": "The bed to command, if the account has more than one."
        },
        "command": {
          "name": "Command",
          "description": "The bedControlCommand code, for example 230 to toggle the under-bed light."
        },
        "payload": {
          "name": "Extra payload",
          "description": "Extra fields to send with the command."
        }
      }
    }
  }
