      "preset_zero_g": { "name": "Zero G" },
      "preset_tv": { "name": "TV" },
      "preset_anti_snore": { "name": "Anti-snore" },
      "preset_favorite": { "name": "Favorite" },
      "program_zero_g": { "name": "Save Zero G position" },
