{
  "config": {
    "step": {
      "user": {
        "title": "Sleeptracker-AI account",
        "description": "Sign in with the account you use in the Tempur Sleeptracker app. The bed has no local API, so control and sleep data go through the Sleeptracker cloud.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "The Sleeptracker cloud rejected the saved password for {email}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password.",
      "cannot_connect": "Could not reach the Sleeptracker cloud."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "reauth_successful": "Signed in again."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "bed_controls": "Control the bed frame from this account",
          "status_interval": "Bed status polling interval",
          "sleep_interval": "Sleep data download interval"
        },
        "data_description": {
          "bed_controls": "Turn off for a second account on the same bed (for example a partner's), so only one account creates the frame's controls.",
          "status_interval": "How often to read the frame's position, massage and light state.",
          "sleep_interval": "How often to download the account's nightly sleep summaries. Each download fetches the whole history."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "frame_connected": { "name": "Frame connected" },
      "cloud_connected": { "name": "Cloud connected" },
      "left_sensor_connected": { "name": "Left sleep sensor" },
      "right_sensor_connected": { "name": "Right sleep sensor" },
      "massage_active": { "name": "Massage" },
      "moving": { "name": "Moving" },
      "panel_light": { "name": "Panel light" }
    },
